  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/http-proxy": "^1.17.17",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "http-proxy": "^1.18.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "android:launch": "expo run:android --binary android/app/build/outputs/apk/debug/app-debug.apk",
    "ios": "expo run:ios",
    "web": "tsx scripts/dev-web.cts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json && tsc -p tsconfig.pwa.json",
    "lint": "expo lint",
    "build:web": "tsx scripts/build-web.cts",
    "preview:web": "tsx scripts/preview-web.cts",
    "test:pwa": "tsx scripts/pwa-smoke.cts",
    "test": "vitest run --testTimeout=20000",
    "test:tools": "tsx --test scripts/web-proxy-policy.test.cts scripts/pwa-policy.test.cts",
    "test:web": "node run-mocked-ui.cjs",
    "verify": "node verify-current.cjs",
    "android:ready": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-ready.ps1"
  },
  "private": true,
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
