# Local Android: run adb reverse tcp:8000 tcp:8000 after the emulator reports device.
# npm run web overrides this for its same-origin proxy at http://127.0.0.1:5175.
# This setting is public. Never add passwords, tokens, or key-service credentials here.
EXPO_PUBLIC_API_ORIGIN=https://messenger.jivo.in

# JM EAS project UUID (do not reuse another app project).

# Production JM API / website: https://messenger.jivo.in
# Expo push setup (pending; keep the project ID blank until configured):
# 1. Run: npx.cmd eas-cli login
# 2. In this JM folder run: npx.cmd eas-cli init
#    Create/link a separate JM project, not the OMS project.
# 3. Copy that project's UUID below. This is NOT the messenger.jivo.in domain.
# 4. In Firebase, add a JM Android app matching app.json android.package:
#    com.anonymous.jivojmuniversal (Android package IDs are separate from website domains).
#    Download its google-services.json to this folder. Do not copy OMS's com.jivo.oms file.
# 5. Set app.json expo.android.googleServicesFile to ./google-services.json.
# 6. Run: npx.cmd eas-cli credentials --platform android
#    Upload matching Firebase FCM v1 service-account credentials to the JM EAS project.
#    Keep the service-account private key out of this app, .env and source control.
# 7. Run npm.cmd run android:build, then npm.cmd run android:launch.
# 8. Enable notifications under Inbox > Settings and send a test notification.
# Backend must deploy /api/jm/push/expo/ on https://messenger.jivo.in.
# If EAS enhanced push security is enabled, set JM_EXPO_ACCESS_TOKEN only in backend .env.
# iOS also needs a registered bundle identifier and matching APNs credentials in EAS.
EXPO_PUBLIC_EAS_PROJECT_ID=
