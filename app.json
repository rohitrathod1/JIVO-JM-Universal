{
  "expo": {
    "name": "JIVO JM",
    "slug": "jivo-jm-universal",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./public/icons/icon-512.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "icon": "./public/icons/maskable-512.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./public/icons/maskable-512.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.jivojmuniversal",
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "favicon": "./public/favicon-32.png"
    },
    "plugins": [
      "expo-router",
      "@preeternal/react-native-cookie-manager",
      "expo-font",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow JIVO JM to record a voice message when you tap Start recording.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow JIVO JM to take a photo when you choose Camera.",
          "photosPermission": false,
          "microphonePermission": "Allow JIVO JM to record a voice message when you choose to record."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow JIVO JM to read the contact you select for sharing."
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow JIVO JM to verify your identity when unlocking the app."
        }
      ],
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": ["text/*", "image/*", "video/*", "audio/*", "application/*"],
            "multipleShareMimeTypes": ["text/*", "image/*", "video/*", "audio/*", "application/*"]
          },
          "ios": { "enabled": false }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow JIVO JM to use your location when you choose to share a location or an event place."
        }
      ],
      "expo-status-bar"
    ],
    "scheme": "jivo-jm"
  }
}
