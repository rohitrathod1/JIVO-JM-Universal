{
  "expo": {
    "name": "JIVO JM",
    "slug": "jivo-jm-universal",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.jivojmuniversal",
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@preeternal/react-native-cookie-manager",
      "expo-font",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow JIVO JM to record a voice message when you tap Start recording.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow JIVO JM to take a photo when you choose Camera.",
          "photosPermission": false,
          "microphonePermission": "Allow JIVO JM to record a voice message when you choose to record."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow JIVO JM to read the contact you select for sharing."
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow JIVO JM to verify your identity when unlocking the app."
        }
      ],
      "expo-sharing",
      "expo-status-bar"
    ],
    "scheme": "jivo-jm"
  }
}
