# Unexecuted template, included inside nginx's http {} context.
# Replace every example value and review against the existing deployment first.
map $http_upgrade $jm_connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 443 ssl;
    server_name jm.example.invalid;
    ssl_certificate /approved/path/fullchain.pem;
    ssl_certificate_key /approved/path/privkey.pem;
    root /approved/path/JIVO-JM-Universal/dist;
    index index.html;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;

    # Compress the JS bundle, fonts and JSON (the initial JS is about 1.8 MB raw, about 480 KB gzip).
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types application/javascript text/javascript text/css application/json application/manifest+json image/svg+xml font/ttf application/x-font-ttf;

    location ~ ^/(api(?:/|$)|ws(?:/|$)|healthz$|readyz$) {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $jm_connection_upgrade;
        proxy_read_timeout 120s;
        proxy_cache off;
    }

    location = /sw.js { add_header Cache-Control "no-cache"; try_files $uri =404; }
    location = /manifest.webmanifest { types { application/manifest+json webmanifest; } add_header Cache-Control "no-cache"; try_files $uri =404; }
    location = /index.html {
        # nginx locations with add_header do not inherit the server's add_header list.
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Frame-Options DENY always;
        try_files $uri =404;
    }
    location ^~ /_expo/ { add_header Cache-Control "public, max-age=31536000, immutable"; try_files $uri =404; }
    location ^~ /assets/ { add_header Cache-Control "public, max-age=31536000, immutable"; try_files $uri =404; }

    # App routes only. Backend admin/files and unknown paths must never get index.html.
    location ~ ^/(|(?:login|home|share|messenger|profile|passwords|notifications|admin|preview|tools|approvals|alerts|atlas|group-info|group-edit)/?|(?:invite|reset-password)/[^/]+/?)$ {
        try_files $uri /index.html;
    }
    location / { try_files $uri =404; }
}
